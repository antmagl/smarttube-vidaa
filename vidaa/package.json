{
  "name": "smarttube-vidaa",
  "version": "0.1.0",
  "description": "SmartTube-inspired web client for Hisense VIDAA TVs, installable as a Sidee launcher tile",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "serve": "python3 scripts/serve.py dist 8090"
  },
  "keywords": [
    "vidaa",
    "hisense",
    "smarttube",
    "youtube",
    "sidee",
    "sponsorblock"
  ],
  "author": "SmartTube VIDAA port contributors",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "core-js": "3.51.0",
    "dashjs": "4.7.4",
    "hls.js": "1.7.3",
    "youtubei.js": "18.3.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yuliskov/SmartTube",
    "directory": "vidaa"
  }
}
